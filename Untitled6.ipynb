        "def cadastro():\n",
biblioteca = {}
 
def adicionar_livro():
    try:
        t = input("Título: ").title()
        if t in biblioteca: raise ValueError("Livro já cadastrado.")
        a = input("Autor: ").title()
        biblioteca[t] = {"autor": a, "emprestado": False}
        print("✅ Adicionado!")
    except Exception as e:
        print("Erro:", e)
 
def emprestar_livro():
    try:
        t = input("Título: ").title()
        if t not in biblioteca: raise KeyError("Não encontrado.")
        if biblioteca[t]["emprestado"]: raise Exception("Já emprestado.")
        biblioteca[t]["emprestado"] = True
        print("📚 Emprestado!")
    except Exception as e:
        print("Erro:", e)
 
def devolver_livro():
    try:
        t = input("Título: ").title()
        if t not in biblioteca: raise KeyError("Não encontrado.")
        if not biblioteca[t]["emprestado"]: raise Exception("Não estava emprestado.")
        biblioteca[t]["emprestado"] = False
        print("📖 Devolvido!")
    except Exception as e:
        print("Erro:", e)
 
def listar_livros_disponiveis():
    disp = [t for t, i in biblioteca.items() if not i["emprestado"]]
    print("\nLivros disponíveis:" if disp else "\nNenhum disponível.")
    for t in disp:
        print(f"- {t} ({biblioteca[t]['autor']})")
 
def buscar_livro():
    try:
        t = input("Título: ").title()
        if t not in biblioteca: raise KeyError("Não encontrado.")
        i = biblioteca[t]
        s = "Emprestado" if i["emprestado"] else "Disponível"
        print(f"{t} - {i['autor']} ({s})")
    except Exception as e:
        print("Erro:", e)
 
while True:
    print("\n1.Adicionar  2.Emprestar  3.Devolver  4.Listar  5.Buscar  0.Sair")
    try:
        op = int(input("Opção: "))
        if op == 1: adicionar_livro()
        elif op == 2: emprestar_livro()
        elif op == 3: devolver_livro()
        elif op == 4: listar_livros_disponiveis()
        elif op == 5: buscar_livro()
        elif op == 0: break
        else: print("Inválido.")
    except ValueError:
        print("Digite um número.")
