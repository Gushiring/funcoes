        "def calcular_custo_hospedagem():\n",
        "    try:\n",
        "        nome_hospede = input(\"Digite o nome do hóspede: \")\n",
        "        quantidade_diarias_str = input(\"Digite a quantidade de diárias: \")\n",
        "\n",
        "        # Tratamento de erro para entrada não numérica\n",
        "        quantidade_diarias = int(quantidade_diarias_str)\n",
        "\n",
        "        if quantidade_diarias < 1:\n",
        "            print(\"A quantidade de diárias deve ser maior que zero.\")\n",
        "            return\n",
        "\n",
        "        taxa_adicional = 0\n",
        "        if quantidade_diarias < 15:\n",
        "            taxa_adicional = 20.00\n",
        "        elif quantidade_diarias == 15:\n",
        "            taxa_adicional = 14.00\n",
        "        else: # quantidade_diarias > 15\n",
        "            taxa_adicional = 12.00\n",
        "\n",
        "        custo_total = (300 * quantidade_diarias) + (taxa_adicional * quantidade_diarias)\n",
        "\n",
        "        print(f\"\\nNome do hóspede: {nome_hospede}\")\n",
        "        print(f\"Valor total a pagar: R$ {custo_total:.2f}\")\n",
        "\n",
        "    except ValueError:\n",
        "        print(\"Erro: A quantidade de diárias deve ser um número inteiro.\")\n",
        "    except Exception as e:\n",
        "        print(f\"Ocorreu um erro: {e}\")\n",
        "\n",
        "# Chama a função para executar o cálculo\n",
        "calcular_custo_hospedagem()"
      ],
